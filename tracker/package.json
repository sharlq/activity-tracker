{
  "name": "@activity-tracker/tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node --test --disable-warning=ExperimentalWarning \"src/**/*.test.ts\""
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "koffi": "^3.3.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  },
  "exports": {
    "./lib": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./report": {
      "types": "./dist/report/index.d.ts",
      "default": "./dist/report/index.js"
    }
  }
}
