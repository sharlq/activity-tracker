{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gym",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "gym",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "demo",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tracker/dist/main.js",
        "demo",
        "--reset",
        "--no-open"
      ],
      "port": 5630,
      "url": "http://raqib-demo.localhost:5630"
    },
    {
      "name": "demo-all",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tracker/dist/main.js",
        "demo",
        "--no-open",
        "--tabs",
        "all",
        "--port",
        "5631"
      ],
      "port": 5631,
      "url": "http://raqib-demo.localhost:5631"
    }
  ]
}
